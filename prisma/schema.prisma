generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
}

enum Transmission {
  AUTOMATIC
  MANUAL
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
}

enum CarStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CLOSED
  ARCHIVED
}

model User {
  id           String   @id @default(uuid())
  name         String?
  email        String   @unique
  passwordHash String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Car {
  id           String       @id @default(uuid())
  slug         String       @unique
  brand        String
  model        String
  year         Int
  mileage      Int
  transmission Transmission
  fuelType     FuelType
  engine       String
  price        Decimal      @db.Decimal(12, 2)
  condition    String
  description  String       @db.Text
  features     String[]
  status       CarStatus    @default(AVAILABLE)
  images       CarImage[]
  enquiries    Enquiry[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([brand])
  @@index([year])
  @@index([price])
  @@index([fuelType])
  @@index([transmission])
  @@index([status])
}

model CarImage {
  id        String   @id @default(uuid())
  url       String
  altText   String
  width     Int
  height    Int
  sortOrder Int      @default(0)
  carId     String
  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([carId, sortOrder])
}

model Enquiry {
  id        String        @id @default(uuid())
  name      String
  email     String
  phone     String?
  message   String       @db.Text
  status    EnquiryStatus @default(NEW)
  carId     String?
  car       Car?         @relation(fields: [carId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([carId])
}
